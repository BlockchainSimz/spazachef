# Backend
ENV=production
ORIGINS=https://your-frontend.example.com
SUPABASE_JWT_SECRET=replace-with-the-project-jwt-secret
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
DATABASE_PATH=/data/spazachef.db

# PayFast ITN. Keep these secrets server-side; never add them to VITE_* variables.
PAYFAST_MERCHANT_ID=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false

# Frontend build-time setting
VITE_API_URL=https://your-backend.example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-the-public-anon-key

