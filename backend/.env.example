# SpazaChef backend environment variables. Keep real values in Vercel/server secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://localhost:6379
JWT_SECRET=GENERATE_A_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
PAYFAST_MERCHANT_ID=YOUR_MERCHANT_ID
PAYFAST_MERCHANT_KEY=YOUR_MERCHANT_KEY
PAYFAST_MODE=test
OZOW_API_KEY=YOUR_OZOW_API_KEY
OZOW_API_SECRET=YOUR_OZOW_SECRET
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
DEBUG=false
ENV=production
