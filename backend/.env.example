# SpazaChef Backend Environment Variables

# Supabase
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_aQGYuHXVJ7xah8ZXlw0Bhw_P8uBOBnf
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Database (set by Supabase automatically if using it)
DATABASE_URL=DATABASE_URL=<configured-in-deployment>

# Redis (for caching & sessions)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_key_here_min_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# PayFast Payment Gateway
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_MODE=test

# Ozow Payment Gateway
OZOW_API_KEY=your_ozow_api_key
OZOW_API_SECRET=your_ozow_secret

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# CORS
ALLOWED_ORIGINS=https://spazachef.vercel.app,http://localhost:5173,http://localhost:3000

# Application
DEBUG=true
ENV=development
