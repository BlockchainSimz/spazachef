# SpazaChef environment template
# Never commit real credentials. Copy to .env locally or configure values in Vercel.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_PUBLISHABLE_KEY
VITE_API_URL=http://localhost:8000
VITE_API_DEV_URL=http://localhost:8000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/spazachef
REDIS_URL=redis://localhost:6379

JWT_SECRET=GENERATE_A_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_TIMEOUT_SECONDS=30

PAYFAST_MERCHANT_ID=YOUR_MERCHANT_ID
PAYFAST_MERCHANT_KEY=YOUR_MERCHANT_KEY
PAYFAST_MODE=test

OZOW_API_KEY=YOUR_OZOW_API_KEY
OZOW_API_SECRET=YOUR_OZOW_SECRET

DEBUG=true
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
